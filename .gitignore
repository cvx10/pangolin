# ===================
# Pangolin Stack .gitignore
# ===================

# -------------------
# Databases
# -------------------
config/db/
config/crowdsec/db/

# -------------------
# CrowdSec Credentials
# -------------------
config/crowdsec/local_api_credentials.yaml
config/crowdsec/online_api_credentials.yaml
config/crowdsec/appsec-rules/*
config/crowdsec/hub/*

# -------------------
# Logs
# -------------------
config/logs/
config/traefik/logs/

# -------------------
# Certificates & Keys
# -------------------
config/letsencrypt/acme.json
config/key

# -------------------
# Configuration with secrets
# -------------------
config/config.yml
.env

# -------------------
# OS & Editor files
# -------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# crowdsec hub-managed symlinks (created by cscli on the server)
config/crowdsec/postoverflows/
config/crowdsec/scenarios/
