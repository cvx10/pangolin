CROWDSEC_LAPI_KEY=YOUR_CROWDSEC_LAPI_KEY_HERE
LETS_ENCRYPT_EMAIL=your-email@example.com
PANGOLIN_DOMAIN=pangolin.your-domain.com

# ── Rendered into config/config.yml by render-config.py ─────────────────────
# Server secret: generate once with `openssl rand -base64 24`. Changing it
# invalidates every Pangolin session.
PANGOLIN_SERVER_SECRET=YOUR_SERVER_SECRET_HERE
# SMTP (Gmail app password — may contain spaces, keep it unquoted)
SMTP_USER=your-email@example.com
SMTP_PASS=YOUR_SMTP_APP_PASSWORD
SMTP_NO_REPLY=your-email@example.com
